# Copy to .env and adjust. Never commit real secrets.
NODE_ENV=development
BACKEND_PORT=4000

POSTGRES_USER=smartdrive
POSTGRES_PASSWORD=changeme_use_strong_password
POSTGRES_DB=smartdrive
POSTGRES_PORT=5432
DATABASE_URL=postgresql://smartdrive:changeme_use_strong_password@localhost:5432/smartdrive?schema=public

REDIS_PORT=6379
REDIS_URL=redis://localhost:6379

JWT_SECRET=changeme_min_32_random_chars

# Public backend URL for the Expo apps. Leave unset to auto-detect the LAN host
# from the Metro dev server. Set it when using a tunnel, e.g.
#   EXPO_PUBLIC_API_URL=https://<random>.trycloudflare.com
# `npm run dev:tunnel` starts the tunnel and writes apps/*/.env.local for you.
EXPO_PUBLIC_API_URL=

# Google Maps key for Android map tiles (see docs/MAPS_SETUP.md).
# Read by apps/*/app.config.js at build time. Never commit a real key.
GOOGLE_MAPS_API_KEY=paste_your_key_here
