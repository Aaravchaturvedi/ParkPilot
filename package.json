{
  "name": "smartdrive-workspace",
  "version": "0.1.0",
  "private": true,
  "description": "SmartDrive & Park Network - dual-sided urban mobility platform (P2P parking + professional drivers)",
  "workspaces": [
    "apps/*",
    "packages/*",
    "backend"
  ],
  "scripts": {
    "dev:backend": "npm run dev -w backend",
    "start:backend": "npm run start -w backend",
    "prisma:generate": "npm run prisma:generate -w backend",
    "prisma:migrate": "npm run prisma:migrate -w backend",
    "docker:up": "docker compose up --build",
    "docker:down": "docker compose down -v",
    "test:mobile": "jest __tests__"
  },
  "engines": {
    "node": ">=20"
  },
  "devDependencies": {
    "@testing-library/react-native": "^13.3.3",
    "@types/jest": "^29.5.14",
    "@types/react": "~19.2.4",
    "@types/react-native": "^0.73.0",
    "axios": "^1.20.0",
    "jest": "^29.7.0",
    "jest-expo": "^57.0.6",
    "metro": "^0.84.0",
    "metro-config": "^0.84.0",
    "metro-resolver": "^0.84.0",
    "react-test-renderer": "^19.2.3",
    "typescript": "^7.0.2"
  },
  "overrides": {
    "react": "19.2.3",
    "react-native": "0.86.3"
  }
}
