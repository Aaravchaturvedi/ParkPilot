// Day 2: Users + Auth. Day 3 adds Vehicles, ParkingSpaces, Bookings + relations.
generator client {
  provider      = "prisma-client-js"
  binaryTargets = ["native", "debian-openssl-3.0.x", "linux-musl"]
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum Role {
  CUSTOMER
  PARTNER
  ADMIN
}

enum KycStatus {
  PENDING
  SUBMITTED
  VERIFIED
  REJECTED
}

model User {
  id           String    @id @default(cuid())
  name         String
  email        String    @unique
  phone        String?   @unique
  passwordHash String
  role         Role      @default(CUSTOMER)
  kycStatus    KycStatus @default(PENDING)
  createdAt    DateTime  @default(now())
  updatedAt    DateTime  @updatedAt

  // Day 3 relations: vehicles, bookingsAsCustomer, bookingsAsPartner, parkingSpaces.

  @@map("users")
}
